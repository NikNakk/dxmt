+
+/* Wine's generic client-surface update otherwise appends every child on top.
+ * Keep Win32 order among participating sibling surfaces, without Win32 calls
+ * or window-data locks on the Cocoa thread. Async blocks retain their views. */
+void macdrv_metal_presentation_order_view(void *object, uintptr_t hwnd, const uintptr_t *above, unsigned int count)
+{
+    static char association_key;
+    WineContentView *view = object;
+    NSMutableArray *siblings = [[NSMutableArray alloc] initWithCapacity:count];
+    for (unsigned int i = 0; i < count; ++i) [siblings addObject:@(above[i])];
+    OnMainThreadAsync(^{
+        objc_setAssociatedObject(view, &association_key, @(hwnd), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        NSView *parent = [view superview], *anchor = nil;
+        if (!parent) return;
+        for (NSNumber *sibling in siblings)
+        {
+            for (NSView *candidate in [parent subviews])
+            {
+                if (candidate != view && ![candidate isHidden] &&
+                    [objc_getAssociatedObject(candidate, &association_key) isEqual:sibling])
+                {
+                    anchor = candidate;
+                    break;
+                }
+            }
+            if (anchor) break;
+        }
+        [parent addSubview:view positioned:anchor ? NSWindowBelow : NSWindowAbove relativeTo:anchor];
+    });
+    [siblings release];
+}
