+/* Experimental generic native interface; no cross-process capability is
+ * advertised on Wine 11.19. SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "wine_metal_presentation.h"
+struct metal_presentation_surface
+{
+    struct macdrv_client_surface surface;
+    LONG submitted;
+};
+static void metal_presentation_update(struct client_surface *client)
+{
+    struct metal_presentation_surface *surface = (struct metal_presentation_surface *)client;
+    HWND sibling;
+    uintptr_t *above = NULL, *grown;
+    unsigned int count = 0, capacity = 0;
+    macdrv_client_surface_update(client);
+    if (client->hwnd != client->toplevel)
+    {
+        for (sibling = NtUserGetWindowRelative(client->hwnd, GW_HWNDPREV); sibling;
+             sibling = NtUserGetWindowRelative(sibling, GW_HWNDPREV))
+        {
+            unsigned int i;
+            /* A concurrently changing HWND chain must not loop forever. */
+            if (sibling == client->hwnd) break;
+            for (i = 0; i < count && above[i] != (uintptr_t)sibling; ++i) {}
+            if (i < count) break;
+            if (count == capacity)
+            {
+                capacity = capacity ? capacity * 2 : 8;
+                if (!(grown = realloc(above, capacity * sizeof(*above)))) break;
+                above = grown;
+            }
+            above[count++] = (uintptr_t)sibling;
+        }
+        macdrv_metal_presentation_order_view(surface->surface.cocoa_view, (uintptr_t)client->hwnd, above, count);
+        free(above);
+    }
+    /* Window changes can replace data->client_view. Reassert the submitted
+     * surface on window notifications, without a per-frame renderer call. */
+    if (InterlockedCompareExchange(&surface->submitted, 0, 0))
+        macdrv_client_surface_present(client, 0);
+}
+static const struct client_surface_funcs metal_presentation_funcs =
+{
+    .size = sizeof(struct metal_presentation_surface),
+    .destroy = macdrv_client_surface_destroy,
+    .detach = macdrv_client_surface_detach,
+    .update = metal_presentation_update,
+    .present = macdrv_client_surface_present,
+};
+static int metal_presentation_create(uintptr_t handle, void *device, void **token, void **layer)
+{
+    HWND hwnd = (HWND)handle, root = NtUserGetAncestor(hwnd, GA_ROOT);
+    struct macdrv_win_data *data;
+    struct macdrv_client_surface *surface;
+    *token = *layer = NULL;
+    if (!root || !(data = get_win_data(root))) return WINE_METAL_PRESENTATION_UNSUPPORTED;
+    if (!data->cocoa_window)
+    {
+        release_win_data(data);
+        return WINE_METAL_PRESENTATION_UNSUPPORTED;
+    }
+    release_win_data(data);
+    if (!(data = get_win_data(hwnd))) return WINE_METAL_PRESENTATION_UNSUPPORTED;
+    release_win_data(data);
+    /* Register Wine geometry notifications, but do not present an empty layer. */
+    if (!(surface = client_surface_create(&metal_presentation_funcs, hwnd, 0, FALSE)))
+        return WINE_METAL_PRESENTATION_FAILED;
+    surface->cocoa_view = macdrv_create_view(cgrect_from_rect(surface->client.monitor_rect));
+    macdrv_set_view_hidden(surface->cocoa_view, TRUE);
+    if (!macdrv_client_surface_acquire_metal_swapchain(surface))
+    {
+        client_surface_release(&surface->client);
+        return WINE_METAL_PRESENTATION_FAILED;
+    }
+    *layer = macdrv_swapchain_get_layer(surface->metal_swapchain);
+    macdrv_metal_presentation_set_device(*layer, device);
+    client_surface_register(&surface->client);
+    if (!(data = get_win_data(hwnd)))
+    {
+        client_surface_release(&surface->client);
+        *layer = NULL;
+        return WINE_METAL_PRESENTATION_FAILED;
+    }
+    if (surface->client.hwnd != hwnd)
+    {
+        release_win_data(data);
+        client_surface_release(&surface->client);
+        *layer = NULL;
+        return WINE_METAL_PRESENTATION_FAILED;
+    }
+    ++data->metal_presentation_users;
+    release_win_data(data);
+    *token = surface;
+    return 0;
+}
+static void metal_presentation_submitted(void *token)
+{
+    struct macdrv_client_surface *surface = token;
+    InterlockedExchange(&((struct metal_presentation_surface *)surface)->submitted, 1);
+    client_surface_present(&surface->client);
+}
+static void metal_presentation_release(void *token)
+{
+    struct macdrv_client_surface *surface = token;
+    struct macdrv_win_data *data;
+    /* Registered surfaces are detached on window destruction; a detached
+     * token must never decrement the ownership of a reused HWND. */
+    if (surface->client.hwnd && (data = get_win_data(surface->client.hwnd)))
+    {
+        if (surface->client.hwnd == data->hwnd && data->metal_presentation_users)
+            --data->metal_presentation_users;
+        release_win_data(data);
+    }
+    client_surface_release(&surface->client);
+}
+__attribute__((visibility("default")))
+const struct wine_metal_presentation_v1 *macdrv_metal_presentation_query_v1(uint32_t version)
+{
+    static const struct wine_metal_presentation_v1 api = {
+        sizeof(api), WINE_METAL_PRESENTATION_VERSION, WINE_METAL_PRESENTATION_LOCAL, 0,
+        metal_presentation_create, metal_presentation_submitted, metal_presentation_release
+    };
+    return version == WINE_METAL_PRESENTATION_VERSION ? &api : NULL;
+}
